<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_hr_payroll_user" model="res.groups">
        <field name="name">Payroll User</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Can view payslips and generate new ones.</field>
    </record>

    <record id="group_hr_payroll_manager" model="res.groups">
        <field name="name">Payroll Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_user'))]"/>
        <field name="comment">Can confirm payslips, mark as paid, and manage salary rules.</field>
    </record>

    <!-- Record Rules for hr.payslip -->
    <record id="ir_rule_hr_payslip_user" model="ir.rule">
        <field name="name">Payslip: Payroll User can see own department</field>
        <field name="model_id" ref="model_hr_payslip"/>
        <field name="groups" eval="[(4, ref('group_hr_payroll_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="ir_rule_hr_payslip_manager" model="ir.rule">
        <field name="name">Payslip: Payroll Manager can see all</field>
        <field name="model_id" ref="model_hr_payslip"/>
        <field name="groups" eval="[(4, ref('group_hr_payroll_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Record Rules for hr.salary.rule -->
    <record id="ir_rule_hr_salary_rule_manager" model="ir.rule">
        <field name="name">Salary Rule: Payroll Manager can manage all</field>
        <field name="model_id" ref="model_hr_salary_rule"/>
        <field name="groups" eval="[(4, ref('group_hr_payroll_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
