<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_hr_payroll_root"
              name="Payroll"
              sequence="50"
              web_icon="hr_payroll_custom,static/description/icon.png"
              groups="hr_payroll_custom.group_hr_payroll_user"/>

    <!-- Payslips Menu -->
    <menuitem id="menu_hr_payslip"
              name="Payslips"
              parent="menu_hr_payroll_root"
              sequence="10"
              action="action_hr_payslip"/>

    <!-- Generate Payslip Menu -->
    <menuitem id="menu_hr_payslip_generate"
              name="Generate Payslip"
              parent="menu_hr_payslip"
              sequence="5"
              action="action_hr_payslip_generate_wizard"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_hr_payroll_config"
              name="Configuration"
              parent="menu_hr_payroll_root"
              sequence="100"
              groups="hr_payroll_custom.group_hr_payroll_manager"/>

    <menuitem id="menu_hr_salary_rule"
              name="Salary Rules"
              parent="menu_hr_payroll_config"
              sequence="10"
              action="action_hr_salary_rule"/>
</odoo>
