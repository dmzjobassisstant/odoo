<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Rule List View -->
    <record id="view_hr_salary_rule_list" model="ir.ui.view">
        <field name="name">hr.salary.rule.list</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <list string="Salary Rules" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="category" widget="badge"/>
                <field name="rate_type"/>
                <field name="rate_value"/>
                <field name="applies_to_all"/>
                <field name="sequence"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Salary Rule Form View -->
    <record id="view_hr_salary_rule_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.form</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <form string="Salary Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="not active">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="applies_to_all"/>
                        </group>
                    </group>
                    <group string="Rate Configuration">
                        <group>
                            <field name="rate_type"/>
                            <field name="rate_value"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Salary Rule Search View -->
    <record id="view_hr_salary_rule_search" model="ir.ui.view">
        <field name="name">hr.salary.rule.search</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <search string="Search Salary Rules">
                <field name="name"/>
                <field name="code"/>
                <filter string="Earnings" name="filter_earning"
                        domain="[('category', '=', 'earning')]"/>
                <filter string="Deductions" name="filter_deduction"
                        domain="[('category', '=', 'deduction')]"/>
                <filter string="Auto-Applied" name="filter_auto"
                        domain="[('applies_to_all', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Salary Rule Action -->
    <record id="action_hr_salary_rule" model="ir.actions.act_window">
        <field name="name">Salary Rules</field>
        <field name="res_model">hr.salary.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure salary rules for automatic payslip calculations
            </p>
            <p>
                Salary rules define how earnings and deductions are calculated.
                Rules marked "Apply to All" are automatically added to every payslip.
            </p>
        </field>
    </record>
</odoo>
