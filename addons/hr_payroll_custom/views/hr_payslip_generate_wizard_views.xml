<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Generate Payslip Wizard Form -->
    <record id="view_hr_payslip_generate_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.generate.wizard.form</field>
        <field name="model">hr.payslip.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payslip">
                <group>
                    <group>
                        <field name="employee_id"
                               domain="[('employment_status', 'in', ('active', 'probation'))]"
                               options="{'no_create': True}"/>
                        <field name="contract_id"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Payslip" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_hr_payslip_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Payslip</field>
        <field name="res_model">hr.payslip.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
