<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default deduction rules - auto-applied to every payslip -->
        <record id="salary_rule_ni" model="hr.salary.rule">
            <field name="name">National Insurance</field>
            <field name="code">NI</field>
            <field name="category">deduction</field>
            <field name="rate_type">percentage</field>
            <field name="rate_value">12.0</field>
            <field name="applies_to_all" eval="True"/>
            <field name="sequence">10</field>
        </record>

        <record id="salary_rule_income_tax" model="hr.salary.rule">
            <field name="name">Income Tax</field>
            <field name="code">TAX</field>
            <field name="category">deduction</field>
            <field name="rate_type">percentage</field>
            <field name="rate_value">20.0</field>
            <field name="applies_to_all" eval="True"/>
            <field name="sequence">20</field>
        </record>

        <record id="salary_rule_pension" model="hr.salary.rule">
            <field name="name">Pension Contribution</field>
            <field name="code">PENSION</field>
            <field name="category">deduction</field>
            <field name="rate_type">percentage</field>
            <field name="rate_value">5.0</field>
            <field name="applies_to_all" eval="True"/>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
