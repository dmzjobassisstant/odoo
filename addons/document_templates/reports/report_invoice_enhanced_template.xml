<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_enhanced">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Company Header Block -->
                        <div class="row mb-4 border-bottom pb-3">
                            <div class="col-7">
                                <h2>
                                    <span t-field="o.company_id.name"/>
                                </h2>
                                <address class="mb-0">
                                    <t t-if="o.company_id.partner_id.street">
                                        <span t-field="o.company_id.partner_id.street"/><br/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.street2">
                                        <span t-field="o.company_id.partner_id.street2"/><br/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.city">
                                        <span t-field="o.company_id.partner_id.city"/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.state_id">
                                        , <span t-field="o.company_id.partner_id.state_id.name"/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.zip">
                                        <span t-field="o.company_id.partner_id.zip"/>
                                    </t>
                                    <t t-if="o.company_id.partner_id.country_id">
                                        <br/><span t-field="o.company_id.partner_id.country_id.name"/>
                                    </t>
                                </address>
                            </div>
                            <div class="col-5 text-right">
                                <t t-if="o.company_id.partner_id.vat">
                                    <strong>VAT:</strong> <span t-field="o.company_id.partner_id.vat"/><br/>
                                </t>
                                <t t-if="o.company_id.phone">
                                    <strong>Phone:</strong> <span t-field="o.company_id.phone"/><br/>
                                </t>
                                <t t-if="o.company_id.email">
                                    <strong>Email:</strong> <span t-field="o.company_id.email"/><br/>
                                </t>
                                <t t-if="o.company_id.website">
                                    <strong>Web:</strong> <span t-field="o.company_id.website"/>
                                </t>
                            </div>
                        </div>

                        <!-- Title -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <h3 class="text-center bg-light py-2">
                                    <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                        INVOICE
                                    </t>
                                    <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                                        DRAFT INVOICE
                                    </t>
                                    <t t-elif="o.move_type == 'out_refund'">
                                        CREDIT NOTE
                                    </t>
                                    <t t-else="">
                                        DOCUMENT
                                    </t>
                                </h3>
                            </div>
                        </div>

                        <!-- Client Address + Invoice Metadata Row -->
                        <div class="row mb-4">
                            <!-- Client Details -->
                            <div class="col-6">
                                <div class="card">
                                    <div class="card-header bg-light"><strong>Bill To</strong></div>
                                    <div class="card-body py-2">
                                        <address class="mb-0" t-field="o.partner_id"
                                            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                        <t t-if="o.partner_id.vat">
                                            <div>
                                                <strong>
                                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                                       t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                                                    <t t-else="">Tax ID</t>:
                                                </strong>
                                                <span t-field="o.partner_id.vat"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- Invoice Metadata -->
                            <div class="col-6">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <th class="text-right" style="width: 40%;">Invoice #:</th>
                                        <td><strong><span t-field="o.name"/></strong></td>
                                    </tr>
                                    <tr t-if="o.invoice_date">
                                        <th class="text-right">Invoice Date:</th>
                                        <td><span t-field="o.invoice_date"/></td>
                                    </tr>
                                    <tr t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                                        <th class="text-right">Due Date:</th>
                                        <td>
                                            <strong style="color: #c0392b;">
                                                <span t-field="o.invoice_date_due"/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr t-if="o.ref">
                                        <th class="text-right">Reference:</th>
                                        <td><span t-field="o.ref"/></td>
                                    </tr>
                                    <tr t-if="o.invoice_origin">
                                        <th class="text-right">Source:</th>
                                        <td><span t-field="o.invoice_origin"/></td>
                                    </tr>
                                    <tr t-if="o.partner_id.ref">
                                        <th class="text-right">Customer Code:</th>
                                        <td><span t-field="o.partner_id.ref"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Line Items Table -->
                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                        <t t-set="has_taxes" t-value="any(l.tax_ids for l in o.invoice_line_ids)"/>
                        <table class="table table-bordered table-sm mb-4" name="enhanced_invoice_lines">
                            <thead class="thead-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Unit Price</th>
                                    <th t-if="display_discount" class="text-right">Disc.%</th>
                                    <th t-if="has_taxes" class="text-right">Tax%</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="o._get_move_lines_to_report()"/>
                                <t t-foreach="lines" t-as="line">
                                    <t t-if="line.display_type == 'product'">
                                        <tr>
                                            <!-- Code column: default_code from product, or custom code -->
                                            <td>
                                                <t t-if="line.product_id">
                                                    <span t-field="line.product_id.default_code"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">-</span>
                                                </t>
                                            </td>
                                            <!-- Description -->
                                            <td>
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                            <!-- Quantity -->
                                            <td class="text-right">
                                                <span t-field="line.quantity" class="text-nowrap"/>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                            </td>
                                            <!-- Unit Price -->
                                            <td class="text-right">
                                                <span class="text-nowrap" t-field="line.price_unit"/>
                                            </td>
                                            <!-- Discount -->
                                            <td t-if="display_discount" class="text-right">
                                                <span class="text-nowrap" t-field="line.discount"/>
                                            </td>
                                            <!-- Tax Rate -->
                                            <td t-if="has_taxes" class="text-right">
                                                <t t-if="line.tax_ids">
                                                    <t t-set="tax_labels" t-value="', '.join(tax.tax_label or tax.name for tax in line.tax_ids)"/>
                                                    <span t-out="tax_labels"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">0%</span>
                                                </t>
                                            </td>
                                            <!-- Line Total -->
                                            <td class="text-right">
                                                <t t-if="o.company_price_include == 'tax_excluded'">
                                                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-nowrap" t-field="line.price_total"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type in ('line_section', 'line_subsection')">
                                        <tr class="fw-bold bg-light">
                                            <td colspan="7">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr class="fst-italic">
                                            <td colspan="7">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals Block -->
                        <div class="row">
                            <div class="col-7">
                                <!-- Payment Terms -->
                                <t t-if="o.invoice_payment_term_id">
                                    <div class="mb-3">
                                        <strong>Payment Terms:</strong>
                                        <span t-field="o.invoice_payment_term_id.name"/>
                                        <t t-if="o.invoice_payment_term_id.note">
                                            <br/><span t-field="o.invoice_payment_term_id.note"/>
                                        </t>
                                    </div>
                                </t>
                                <!-- Payment Details -->
                                <t t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference">
                                    <div class="mb-3">
                                        <strong>Payment Reference:</strong>
                                        <span t-field="o.payment_reference"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-5">
                                <table class="table table-borderless table-sm o_total_table">
                                    <!-- Tax Summary -->
                                    <t t-if="o.tax_totals">
                                        <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="subtotal">
                                            <tr>
                                                <td class="text-right">
                                                    <span t-out="subtotal.get('name', 'Untaxed Amount')"/>:
                                                </td>
                                                <td class="text-right">
                                                    <span t-out="subtotal.get('base_amount_currency', 0.00)"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                                                <tr>
                                                    <td class="text-right">
                                                        <span t-out="tax_group.get('group_name', 'Tax')"/>:
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-out="tax_group.get('tax_amount_currency', 0.00)"
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <tr class="fw-bold" style="font-size: 1.1em; border-top: 2px solid #333;">
                                            <td class="text-right">Total:</td>
                                            <td class="text-right">
                                                <strong>
                                                    <span t-out="o.tax_totals.get('total_amount_currency', 0.00)"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr class="fw-bold" style="border-top: 2px solid #333;">
                                            <td class="text-right">Total:</td>
                                            <td class="text-right">
                                                <strong>
                                                    <span t-field="o.amount_total"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Amount Due if payments exist -->
                                    <t t-if="o.amount_residual != o.amount_total and o.state == 'posted'">
                                        <tr class="fw-bold">
                                            <td class="text-right">Amount Due:</td>
                                            <td class="text-right" style="color: #c0392b;">
                                                <strong>
                                                    <span t-field="o.amount_residual"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>

                        <!-- Bank Details Footer -->
                        <div class="row mt-4 pt-3 border-top">
                            <div class="col-6">
                                <t t-if="o.company_id.partner_id.bank_ids">
                                    <h6>Bank Details</h6>
                                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                        <div class="mb-1 small">
                                            <strong><span t-field="bank.bank_id.name"/></strong><br/>
                                            Account: <span t-field="bank.acc_number"/>
                                            <t t-if="bank.acc_holder_name">
                                                (<span t-field="bank.acc_holder_name"/>)
                                            </t>
                                            <t t-if="bank.bank_id.bic">
                                                <br/>BIC/SWIFT: <span t-field="bank.bank_id.bic"/>
                                            </t>
                                        </div>
                                    </t>
                                </t>
                            </div>
                            <div class="col-6 text-right text-muted small">
                                <p>This is a computer-generated document.</p>
                                <t t-if="o.company_id.currency_id">
                                    <p>All amounts in <span t-field="o.company_id.currency_id.name"/>.</p>
                                </t>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
