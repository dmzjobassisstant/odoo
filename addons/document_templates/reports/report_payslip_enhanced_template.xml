<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_enhanced">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <style type="text/css">
                    body {
                        font-family: <t t-out="font_family"/>;
                    }
                    .page h2, .page h3, .page h6, .page strong, .page th {
                        color: <t t-out="primary_color"/>;
                    }
                    .page .thead-light th {
                        background-color: <t t-out="secondary_color"/>;
                        color: <t t-out="primary_color"/>;
                        font-weight: 600;
                    }
                    .page .table-bordered, .page .table-bordered td, .page .table-bordered th {
                        border-color: <t t-out="secondary_color"/>;
                    }
                    .page .border-top { border-color: <t t-out="secondary_color"/> !important; }
                    .page .table-success td { background-color: #e8f5e9 !important; }
                    .page .table-danger td { background-color: #ffebee !important; }
                    .page .table-primary td { background-color: #e3f2fd !important; }
                    .page td.text-right strong { color: <t t-out="primary_color"/>; }
                </style>
                <t t-if="css_override">
                    <style type="text/css">
                        <t t-out="css_override"/>
                    </style>
                </t>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Custom Header -->
                        <t t-if="custom_header">
                            <div class="custom-header mb-3">
                                <t t-out="custom_header"/>
                            </div>
                        </t>

                        <!-- Header with optional logo -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <t t-if="logo">
                                    <img t-att-src="'data:image/png;base64,%s' % logo"
                                         style="max-height: 50px; max-width: 200px;"
                                         alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <h2>Payslip</h2>
                                </t>
                                <p>
                                    <strong t-out="o.name"/>
                                </p>
                            </div>
                            <div class="col-6 text-right">
                                <p>
                                    <t t-if="not logo">
                                        <strong t-out="o.company_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.company_id.name"/>
                                    </t>
                                    <br/>
                                    <span t-if="o.company_id.partner_id.street"
                                          t-field="o.company_id.partner_id.street"/>
                                    <br/>
                                    <span t-if="o.company_id.phone"
                                          t-field="o.company_id.phone"/>
                                </p>
                            </div>
                        </div>

                        <!-- Employee & Period Info -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <th>Employee:</th>
                                        <td t-out="o.employee_id.name"/>
                                    </tr>
                                    <tr t-if="o.employee_id.job_id">
                                        <th>Job Position:</th>
                                        <td t-out="o.employee_id.job_id.name"/>
                                    </tr>
                                    <tr t-if="o.employee_id.department_id">
                                        <th>Department:</th>
                                        <td t-out="o.employee_id.department_id.name"/>
                                    </tr>
                                    <tr t-if="o.contract_id">
                                        <th>Contract:</th>
                                        <td t-out="o.contract_id.name"/>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <th>Pay Period:</th>
                                        <td>
                                            <span t-field="o.period_start"/>
                                            to
                                            <span t-field="o.period_end"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Status:</th>
                                        <td t-out="dict(o._fields['state'].selection).get(o.state, o.state)"/>
                                    </tr>
                                    <tr t-if="o.timesheet_ids">
                                        <th>Timesheets:</th>
                                        <td t-out="len(o.timesheet_ids)"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Payslip Lines Table -->
                        <table class="table table-bordered table-sm mb-4">
                            <thead class="thead-light">
                                <tr>
                                    <th>Description</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-success">
                                    <td colspan="2"><strong>Earnings</strong></td>
                                </tr>
                                <t t-foreach="o.payslip_line_ids.filtered(lambda l: l.category == 'earning').sorted(key='sequence')" t-as="line">
                                    <tr>
                                        <td t-out="line.name"/>
                                        <td class="text-right">
                                            <span t-field="line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="fw-bold">
                                    <td class="text-right">Gross Pay</td>
                                    <td class="text-right">
                                        <strong>
                                            <span t-field="o.gross_pay"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>

                                <tr class="table-danger">
                                    <td colspan="2"><strong>Deductions</strong></td>
                                </tr>
                                <t t-foreach="o.payslip_line_ids.filtered(lambda l: l.category == 'deduction').sorted(key='sequence')" t-as="line">
                                    <tr>
                                        <td t-out="line.name"/>
                                        <td class="text-right">
                                            <span t-field="line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="fw-bold">
                                    <td class="text-right">Total Deductions</td>
                                    <td class="text-right">
                                        <strong>
                                            <span t-field="o.total_deductions"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>

                                <tr class="table-primary" style="font-size: 1.2em;">
                                    <td class="text-right"><strong>Net Pay</strong></td>
                                    <td class="text-right">
                                        <strong>
                                            <span t-field="o.net_pay"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Custom Footer -->
                        <t t-if="custom_footer">
                            <div class="row mt-4 pt-3 border-top">
                                <div class="col-12">
                                    <t t-out="custom_footer"/>
                                </div>
                            </div>
                        </t>

                        <div class="row mt-5 pt-4 border-top">
                            <div class="col-12 text-center text-muted" style="font-size: 0.85em;">
                                <p>
                                    This is a computer-generated payslip.
                                    <t t-if="o.state == 'paid'">
                                        <br/>Payment confirmed.
                                    </t>
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
