<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions -->
    <record id="action_board_metric" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">board.metric</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="board_metric_view_search"/>
    </record>

    <record id="action_board_report" model="ir.actions.act_window">
        <field name="name">Board Reports</field>
        <field name="res_model">board.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="board_report_view_search"/>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_board_reporting_root"
              name="Board Reports"
              web_icon="board_reporting,static/description/icon.png"
              sequence="95"/>

    <!-- Sub-menus -->
    <menuitem id="menu_board_metric"
              name="Metrics"
              parent="menu_board_reporting_root"
              action="action_board_metric"
              sequence="10"
              groups="board_reporting.group_board_report_manager"/>

    <menuitem id="menu_board_report"
              name="Reports"
              parent="menu_board_reporting_root"
              action="action_board_report"
              sequence="20"/>

</odoo>
