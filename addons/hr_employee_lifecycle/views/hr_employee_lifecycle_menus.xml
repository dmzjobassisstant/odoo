<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window actions (must be defined before menuitems) -->
    <record id="action_hr_lifecycle_contracts" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.lifecycle.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_hr_offboarding" model="ir.actions.act_window">
        <field name="name">Offboarding</field>
        <field name="res_model">hr.offboarding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_hr_offboarding_tasks" model="ir.actions.act_window">
        <field name="name">Offboarding Task Templates</field>
        <field name="res_model">hr.offboarding.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_default', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <!-- Main menu entry under Employees -->
    <menuitem id="menu_hr_lifecycle_root"
              name="Lifecycle"
              parent="hr.menu_hr_root"
              sequence="50"
              groups="hr_employee_lifecycle.group_hr_lifecycle_manager,hr_employee_lifecycle.group_hr_lifecycle_officer"/>

    <!-- Contracts submenu -->
    <menuitem id="menu_hr_lifecycle_contracts"
              name="Contracts"
              parent="menu_hr_lifecycle_root"
              sequence="10"
              action="action_hr_lifecycle_contracts"/>

    <!-- Offboarding submenu -->
    <menuitem id="menu_hr_offboarding"
              name="Offboarding"
              parent="menu_hr_lifecycle_root"
              sequence="20"
              action="action_hr_offboarding"/>

    <!-- Offboarding task templates -->
    <menuitem id="menu_hr_offboarding_tasks"
              name="Task Templates"
              parent="menu_hr_lifecycle_root"
              sequence="30"
              action="action_hr_offboarding_tasks"
              groups="hr_employee_lifecycle.group_hr_lifecycle_manager"/>
</odoo>
