<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default offboarding task templates -->
        <record id="offboarding_task_exit_interview" model="hr.offboarding.task">
            <field name="name">Conduct exit interview</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">10</field>
        </record>
        <record id="offboarding_task_return_laptop" model="hr.offboarding.task">
            <field name="name">Collect laptop and IT equipment</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">20</field>
        </record>
        <record id="offboarding_task_revoke_access" model="hr.offboarding.task">
            <field name="name">Revoke system access and email</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">30</field>
        </record>
        <record id="offboarding_task_return_badge" model="hr.offboarding.task">
            <field name="name">Collect access badge and keys</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">40</field>
        </record>
        <record id="offboarding_task_final_pay" model="hr.offboarding.task">
            <field name="name">Process final paycheck and settlement</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">50</field>
        </record>
        <record id="offboarding_task_benefits" model="hr.offboarding.task">
            <field name="name">Process benefits termination</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">60</field>
        </record>
        <record id="offboarding_task_documentation" model="hr.offboarding.task">
            <field name="name">Prepare final documentation</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">70</field>
        </record>

        <!-- IR sequence for offboarding references -->
        <record id="seq_hr_offboarding" model="ir.sequence">
            <field name="name">HR Offboarding</field>
            <field name="code">hr.offboarding</field>
            <field name="prefix">OFF</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
