<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Manager: see all employees -->
        <record id="rule_hr_employee_manager_all" model="ir.rule">
            <field name="name">HR Manager: See all employees</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Manager: see all contracts -->
        <record id="rule_hr_contract_manager_all" model="ir.rule">
            <field name="name">HR Manager: See all contracts</field>
            <field name="model_id" ref="hr_employee_lifecycle.model_hr_lifecycle_contract"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Manager: see all offboarding -->
        <record id="rule_hr_offboarding_manager_all" model="ir.rule">
            <field name="name">HR Manager: See all offboarding</field>
            <field name="model_id" ref="hr_employee_lifecycle.model_hr_offboarding"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Manager: see all offboarding tasks -->
        <record id="rule_hr_offboarding_task_manager_all" model="ir.rule">
            <field name="name">HR Manager: See all offboarding tasks</field>
            <field name="model_id" ref="hr_employee_lifecycle.model_hr_offboarding_task"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Officer: see all offboarding -->
        <record id="rule_hr_offboarding_officer_all" model="ir.rule">
            <field name="name">HR Officer: See all offboarding</field>
            <field name="model_id" ref="hr_employee_lifecycle.model_hr_offboarding"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Officer: see all offboarding tasks -->
        <record id="rule_hr_offboarding_task_officer_all" model="ir.rule">
            <field name="name">HR Officer: See all offboarding tasks</field>
            <field name="model_id" ref="hr_employee_lifecycle.model_hr_offboarding_task"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Officer: read all contracts -->
        <record id="rule_hr_contract_officer_read" model="ir.rule">
            <field name="name">HR Officer: Read all contracts</field>
            <field name="model_id" ref="hr_employee_lifecycle.model_hr_lifecycle_contract"/>
            <field name="groups" eval="[(4, ref('hr_employee_lifecycle.group_hr_lifecycle_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
