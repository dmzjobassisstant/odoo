<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Manager group: full access -->
        <record id="group_hr_lifecycle_manager" model="res.groups">
            <field name="name">HR Lifecycle Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="comment">Full access to HR Lifecycle: contracts, offboarding, employee lifecycle management.</field>
        </record>

        <!-- Officer group: limited access -->
        <record id="group_hr_lifecycle_officer" model="res.groups">
            <field name="name">HR Lifecycle Officer</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="comment">Can process offboarding and read contracts.</field>
        </record>
    </data>
</odoo>
