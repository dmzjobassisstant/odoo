<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== User Groups ===== -->
    <record id="group_timesheet_user" model="res.groups">
        <field name="name">Timesheet User</field>
        <field name="comment">Can create, view, and submit own timesheets.</field>
    </record>

    <record id="group_timesheet_admin" model="res.groups">
        <field name="name">Timesheet Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="comment">Full access to all timesheets. Can lock, unlock, and delete timesheets.</field>
    </record>

    <!-- ===== Record Rules: Timesheet Week ===== -->

    <record id="rule_timesheet_week_user_own" model="ir.rule">
        <field name="name">User: own timesheet weeks only</field>
        <field name="model_id" ref="model_timesheet_week"/>
        <field name="groups" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_timesheet_week_admin_all" model="ir.rule">
        <field name="name">Admin: all timesheet weeks</field>
        <field name="model_id" ref="model_timesheet_week"/>
        <field name="groups" eval="[(4, ref('group_timesheet_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ===== Record Rules: Timesheet Entry ===== -->

    <record id="rule_timesheet_entry_user_own" model="ir.rule">
        <field name="name">User: own timesheet entries</field>
        <field name="model_id" ref="model_timesheet_entry"/>
        <field name="groups" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="domain_force">[('week_id.employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_timesheet_entry_admin_all" model="ir.rule">
        <field name="name">Admin: all timesheet entries</field>
        <field name="model_id" ref="model_timesheet_entry"/>
        <field name="groups" eval="[(4, ref('group_timesheet_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
