<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Add Tasks Wizard Form ===== -->
    <record id="view_timesheet_add_tasks_wizard_form" model="ir.ui.view">
        <field name="name">timesheet.add.tasks.wizard.form</field>
        <field name="model">timesheet.add.tasks.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Tasks to Week">
                <sheet>
                    <group>
                        <group>
                            <field name="week_id" invisible="1"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Available Tasks" colspan="4">
                        <field name="task_ids" nolabel="1" colspan="4"
                            widget="many2many_tags"
                            options="{'no_create_edit': True}"/>
                    </group>
                    <footer>
                        <button name="action_add" type="object"
                            string="Add Tasks" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
