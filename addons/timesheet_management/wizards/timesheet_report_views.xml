<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_timesheet_report_wizard_form" model="ir.ui.view">
        <field name="name">timesheet.report.wizard.form</field>
        <field name="model">timesheet.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Timesheet Report">
                <group>
                    <group>
                        <field name="project_id"
                               placeholder="All Projects"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Excel" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timesheet_report_wizard" model="ir.actions.act_window">
        <field name="name">Timesheet Report</field>
        <field name="res_model">timesheet.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
