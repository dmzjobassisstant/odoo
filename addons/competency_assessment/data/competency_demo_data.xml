<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default Proficiency Levels -->
    <record id="level_supervised" model="competency.level">
        <field name="name">Supervised</field>
        <field name="code">SUP</field>
        <field name="sequence">10</field>
        <field name="description">Works under close supervision. Requires guidance for most tasks.</field>
    </record>
    <record id="level_practitioner" model="competency.level">
        <field name="name">Practitioner</field>
        <field name="code">PRA</field>
        <field name="sequence">20</field>
        <field name="description">Works independently on routine tasks. Requires guidance for complex scenarios.</field>
    </record>
    <record id="level_lead_practitioner" model="competency.level">
        <field name="name">Lead Practitioner</field>
        <field name="code">LEAD</field>
        <field name="sequence">30</field>
        <field name="description">Works autonomously. Guides and mentors others. Handles complex and novel scenarios.</field>
    </record>

    <!-- Assessment Sequence is defined in security/competency_security.xml
         (seq_competency_assessment). The duplicate that was here has been
         removed to avoid a duplicate ir.sequence code conflict. -->
</odoo>
