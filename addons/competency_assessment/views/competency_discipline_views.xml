<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discipline_tree" model="ir.ui.view">
        <field name="name">competency.discipline.tree</field>
        <field name="model">competency.discipline</field>
        <field name="arch" type="xml">
            <list string="Disciplines">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_discipline_form" model="ir.ui.view">
        <field name="name">competency.discipline.form</field>
        <field name="model">competency.discipline</field>
        <field name="arch" type="xml">
            <form string="Discipline">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="lead_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Competencies">
                            <field name="competency_ids" context="{'default_discipline_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="competency_code"/>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
