<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_assessment_form" model="ir.ui.view">
        <field name="name">competency.project.assessment.form</field>
        <field name="model">competency.project.assessment</field>
        <field name="arch" type="xml">
            <form string="Project Competency Assessment">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_analyze_all_gaps" type="object"
                            string="Analyze All Gaps" class="btn-secondary"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <label for="name" string="Assessment"/>
                    <div class="o_row">
                        <field name="name" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="project_id"/>
                        <field name="assessment_date"/>
                    </group>
                    <field name="company_id" invisible="1"/>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Assessment scope, objectives..."/>
                    </group>
                    <notebook>
                        <page string="Role Assignments">
                            <field name="role_assignment_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="role_id"/>
                                    <field name="employee_id"/>
                                    <field name="gap_status" widget="badge"
                                           decoration-success="gap_status == 'ok'"
                                           decoration-warning="gap_status == 'gaps'"
                                           decoration-danger="gap_status == 'missing'"/>
                                    <field name="required_competency_count" string="Req"
                                           sum="Total"/>
                                    <field name="missing_competency_count" string="Gaps"
                                           sum="Total"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="role_id"
                                                   help="Select a role. Required competency levels are pre-populated from the role definition — adjust per-project as needed below."/>
                                            <field name="employee_id"/>
                                            <field name="assigned_date"/>
                                        </group>
                                        <group>
                                            <field name="notes"/>
                                        </group>
                                    </group>
                                    <group string="Gap Summary">
                                        <group>
                                            <field name="required_competency_count"/>
                                            <field name="met_competency_count"/>
                                        </group>
                                        <group>
                                            <field name="below_level_count"/>
                                            <field name="missing_competency_count"/>
                                        </group>
                                        <button name="action_analyze_gap" type="object"
                                                string="Refresh Gap Analysis"
                                                class="btn-secondary" colspan="2"/>
                                    </group>
                                    <separator string="Competency Gap Comparison &amp; Coverage Plans" colspan="4"/>
                                    <field name="competency_level_ids" nolabel="1" colspan="4">
                                        <list editable="bottom">
                                            <field name="competency_id" string="Competency"
                                                   readonly="1"/>
                                            <field name="required_level_id" string="Required Level"
                                                   help="Adjust the required level for this project if different from role default."/>
                                            <field name="employee_level_id"
                                                   string="Employee Level" readonly="1"/>
                                            <field name="gap_summary" string="Gap Analysis"
                                                   decoration-danger="is_gap == True"
                                                   decoration-success="is_gap == False"/>
                                            <field name="is_coverage_needed"
                                                   string="Cover?"/>
                                            <field name="coverage_status"
                                                   widget="badge"
                                                   decoration-warning="coverage_status == 'open'"
                                                   decoration-info="coverage_status == 'planned'"
                                                   decoration-primary="coverage_status == 'in_progress'"
                                                   decoration-success="coverage_status == 'resolved'"/>
                                        </list>
                                        <form>
                                            <group>
                                                <group>
                                                    <field name="competency_id" readonly="1"/>
                                                    <field name="required_level_id"
                                                           help="Adjust the required level for this specific project."/>
                                                    <field name="employee_level_id" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="gap_summary"
                                                           decoration-danger="is_gap == True"
                                                           decoration-success="is_gap == False"/>
                                                    <field name="is_coverage_needed"/>
                                                    <field name="coverage_status"/>
                                                    <field name="coverage_target_date"/>
                                                </group>
                                            </group>
                                            <group string="Coverage / Action Plan"
                                                   invisible="not is_coverage_needed"
                                                   colspan="2">
                                                <field name="coverage_plan" nolabel="1"
                                                       placeholder="Describe how management plans to cover this gap (training, mentoring, reassignment, external hire, etc.)..."/>
                                            </group>
                                        </form>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Gap Summary">
                            <group string="Overall">
                                <field name="total_assignments"/>
                                <field name="assignments_with_gaps"/>
                                <field name="total_gaps"/>
                            </group>
                            <separator string="Per-Role Breakdown" colspan="4"/>
                            <field name="role_assignment_ids" nolabel="1">
                                <list>
                                    <field name="role_id"/>
                                    <field name="employee_id"/>
                                    <field name="gap_status" widget="badge"
                                           decoration-success="gap_status == 'ok'"
                                           decoration-warning="gap_status == 'gaps'"
                                           decoration-danger="gap_status == 'missing'"/>
                                    <field name="required_competency_count"/>
                                    <field name="met_competency_count"/>
                                    <field name="below_level_count"/>
                                    <field name="missing_competency_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_project_assessment_list" model="ir.ui.view">
        <field name="name">competency.project.assessment.list</field>
        <field name="model">competency.project.assessment</field>
        <field name="arch" type="xml">
            <list string="Project Assessments">
                <field name="name"/>
                <field name="project_id"/>
                <field name="state"/>
                <field name="assessment_date"/>
                <field name="total_gaps" string="Gaps"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_project_assessment_search" model="ir.ui.view">
        <field name="name">competency.project.assessment.search</field>
        <field name="model">competency.project.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="state_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="state_in_progress" string="In Progress"
                        domain="[('state','=','in_progress')]"/>
                <filter name="state_done" string="Done" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>
</odoo>
