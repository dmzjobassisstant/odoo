<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Assessment Kanban ===== -->
    <record id="view_assessment_kanban" model="ir.ui.view">
        <field name="name">competency.assessment.kanban</field>
        <field name="model">competency.assessment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="discipline_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card_header">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <div class="text-muted"><field name="employee_id"/></div>
                                <div class="text-muted"><field name="discipline_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===== Assessment Tree ===== -->
    <record id="view_assessment_tree" model="ir.ui.view">
        <field name="name">competency.assessment.tree</field>
        <field name="model">competency.assessment</field>
        <field name="arch" type="xml">
            <list string="Assessments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="discipline_id"/>
                <field name="state"/>
                <field name="assessment_date"/>
                <field name="lead_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ===== Assessment Form ===== -->
    <record id="view_assessment_form" model="ir.ui.view">
        <field name="name">competency.assessment.form</field>
        <field name="model">competency.assessment</field>
        <field name="arch" type="xml">
            <form string="Competency Assessment">
                <header>
                    <button name="action_self_assess" type="object" string="Submit Self-Assessment" class="btn-primary" confirm="Submit your self-assessment for lead review?"/>
                    <button name="action_lead_review" type="object" string="Lead Review Complete" class="btn-warning" groups="competency_assessment.group_discipline_lead"/>
                    <button name="action_employee_accept" type="object" string="Accept" class="btn-success" confirm="Accept the lead's assessment?"/>
                    <button name="action_lead_confirm" type="object" string="Confirm Final" class="btn-primary" groups="competency_assessment.group_discipline_lead" confirm="Confirm the assessment as final?"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="discipline_id"/>
                            <field name="assessment_date"/>
                        </group>
                        <group>
                            <field name="lead_id" readonly="1"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                            <field name="employee_acceptance_date" readonly="1"/>
                            <field name="lead_confirmation_date" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assessment Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="competency_name" readonly="1"/>
                                    <field name="self_assessed_level_id"/>
                                    <field name="employee_comment"/>
                                    <field name="lead_evaluation"/>
                                    <field name="lead_assigned_level_id"/>
                                    <field name="lead_comment"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="competency_name" readonly="1"/>
                                                <field name="competency_description" readonly="1"/>
                                                <field name="criteria_display" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="self_assessed_level_id"/>
                                                <field name="employee_comment"/>
                                                <field name="lead_evaluation"/>
                                                <field name="lead_assigned_level_id"/>
                                                <field name="lead_comment"/>
                                            </group>
                                        </group>
                                        <group string="Evidence">
                                            <field name="attachment_ids" widget="many2many_binary"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===== Assessment Search ===== -->
    <record id="view_assessment_search" model="ir.ui.view">
        <field name="name">competency.assessment.search</field>
        <field name="model">competency.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="discipline_id"/>
                <filter name="state_done" string="Done" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <!-- ===== Register View ===== -->
    <record id="view_assessment_register_tree" model="ir.ui.view">
        <field name="name">competency.assessment.register.tree</field>
        <field name="model">competency.assessment</field>
        <field name="arch" type="xml">
            <list string="Assessment Register">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="discipline_id"/>
                <field name="state"/>
                <field name="assessment_date"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <!-- ===== Register Search ===== -->
    <record id="view_assessment_register_search" model="ir.ui.view">
        <field name="name">competency.assessment.register.search</field>
        <field name="model">competency.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="discipline_id"/>
            </search>
        </field>
    </record>
</odoo>
