<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Role Form ===== -->
    <record id="view_role_form" model="ir.ui.view">
        <field name="name">competency.role.form</field>
        <field name="model">competency.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="discipline_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Required Competencies">
                            <field name="role_competency_ids">
                                <list editable="bottom">
                                    <field name="competency_id"/>
                                    <field name="required_level_id"/>
                                    <field name="notes"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="competency_id"/>
                                            <field name="required_level_id"/>
                                            <field name="notes"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===== Role List ===== -->
    <record id="view_role_list" model="ir.ui.view">
        <field name="name">competency.role.list</field>
        <field name="model">competency.role</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="name"/>
                <field name="code"/>
                <field name="discipline_id"/>
                <field name="competency_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ===== Role Search ===== -->
    <record id="view_role_search" model="ir.ui.view">
        <field name="name">competency.role.search</field>
        <field name="model">competency.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="discipline_id"/>
            </search>
        </field>
    </record>
</odoo>
