<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Actions (defined first so menus can reference them) ===== -->
    <record id="action_discipline" model="ir.actions.act_window">
        <field name="name">Disciplines</field>
        <field name="res_model">competency.discipline</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_level" model="ir.actions.act_window">
        <field name="name">Proficiency Levels</field>
        <field name="res_model">competency.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">competency.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">competency.competency</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_assessment" model="ir.actions.act_window">
        <field name="name">All Assessments</field>
        <field name="res_model">competency.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_assessment_register" model="ir.actions.act_window">
        <field name="name">Assessment Register</field>
        <field name="res_model">competency.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_assessment_historical" model="ir.actions.act_window">
        <field name="name">Historical Assessments</field>
        <field name="res_model">competency.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('done', 'cancelled'))]</field>
    </record>

    <record id="action_self_assessment_wizard" model="ir.actions.act_window">
        <field name="name">Self Assessment</field>
        <field name="res_model">competency.self.assessment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_project_assessment" model="ir.actions.act_window">
        <field name="name">Project Assessments</field>
        <field name="res_model">competency.project.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== Menus ===== -->
    <menuitem id="menu_competency_root" name="Competencies" sequence="50"/>

    <menuitem id="menu_competency_config" name="Configuration" parent="menu_competency_root"/>

    <menuitem id="menu_discipline" name="Disciplines" parent="menu_competency_config"
              action="action_discipline"/>
    <menuitem id="menu_level" name="Proficiency Levels" parent="menu_competency_config"
              action="action_level"/>
    <menuitem id="menu_role" name="Roles" parent="menu_competency_config"
              action="action_role"/>

    <menuitem id="menu_competency_framework" name="Framework" parent="menu_competency_root"/>
    <menuitem id="menu_competency" name="Competencies" parent="menu_competency_framework"
              action="action_competency"/>

    <menuitem id="menu_competency_assessments" name="Assessments" parent="menu_competency_root"/>
    <menuitem id="menu_self_assessment" name="Self Assessment" parent="menu_competency_assessments"
              action="action_self_assessment_wizard"/>

    <menuitem id="menu_assessment_register" name="Assessment Register" parent="menu_competency_assessments"
              action="action_assessment_register"
              groups="competency_assessment.group_discipline_lead"/>
    <menuitem id="menu_assessment_all" name="All Assessments" parent="menu_competency_assessments"
              action="action_assessment"
              groups="competency_assessment.group_discipline_lead"/>
    <menuitem id="menu_assessment_historical" name="Historical Assessments" parent="menu_competency_assessments"
              action="action_assessment_historical"
              groups="competency_assessment.group_competency_admin"/>

    <menuitem id="menu_project_assessment" name="Project Assessments" parent="menu_competency_root"
              action="action_project_assessment"/>
</odoo>
