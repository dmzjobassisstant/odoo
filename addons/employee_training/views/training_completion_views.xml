<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Training Completion Form View -->
    <record id="view_training_completion_form" model="ir.ui.view">
        <field name="name">training.completion.form</field>
        <field name="model">training.completion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="course_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="assignment_id"/>
                            <field name="completed_date"/>
                        </group>
                        <group>
                            <field name="score"/>
                        </group>
                    </group>
                    <group string="Certificate">
                        <field name="certificate" widget="binary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Training Completion List View -->
    <record id="view_training_completion_list" model="ir.ui.view">
        <field name="name">training.completion.list</field>
        <field name="model">training.completion</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="course_id"/>
                <field name="completed_date"/>
                <field name="score"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_training_completion" model="ir.actions.act_window">
        <field name="name">Training Completions</field>
        <field name="res_model">training.completion</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
