<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="module_category_training" model="ir.module.category">
        <field name="name">Employee Training</field>
        <field name="sequence">17</field>
    </record>

    <record id="group_training_user" model="res.groups">
        <field name="name">Training User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_manager" model="res.groups">
        <field name="name">Training Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_training_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</data>
<data noupdate="1">

    <!-- Employees can only see their own assignments -->
    <record id="training_assignment_personal_rule" model="ir.rule">
        <field name="name">Training Assignment: own</field>
        <field name="model_id" ref="model_training_assignment"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('assigned_by.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <record id="training_assignment_manager_rule" model="ir.rule">
        <field name="name">Training Assignment: manager sees all</field>
        <field name="model_id" ref="model_training_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_manager'))]"/>
    </record>

    <record id="training_completion_personal_rule" model="ir.rule">
        <field name="name">Training Completion: own</field>
        <field name="model_id" ref="model_training_completion"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <record id="training_completion_manager_rule" model="ir.rule">
        <field name="name">Training Completion: manager sees all</field>
        <field name="model_id" ref="model_training_completion"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_manager'))]"/>
    </record>

</data>
</odoo>
