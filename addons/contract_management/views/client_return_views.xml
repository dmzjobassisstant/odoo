<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Return List View -->
    <record id="view_client_return_list" model="ir.ui.view">
        <field name="name">client.return.list</field>
        <field name="model">client.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="return_reason"/>
                <field name="state"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <field name="refund_invoice_id"/>
            </list>
        </field>
    </record>

    <!-- Return Form View -->
    <record id="view_client_return_form" model="ir.ui.view">
        <field name="name">client.return.form</field>
        <field name="model">client.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" type="object" string="Receive" invisible="state != 'approved'"/>
                    <button name="action_inspect" type="object" string="Inspect" invisible="state != 'received'"/>
                    <button name="action_refund" type="object" string="Refund" class="btn-primary" invisible="state not in ('received', 'inspected')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('draft', 'approved')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('refunded', 'cancelled')"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_view_refund" type="object" string="View Credit Note" invisible="not refund_invoice_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,received,refunded,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="main_info">
                            <field name="partner_id"/>
                            <field name="return_reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="reference">
                            <field name="sale_order_id"/>
                            <field name="invoice_id"/>
                            <field name="refund_invoice_id" readonly="1" invisible="not refund_invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Return Lines" name="lines">
                            <field name="return_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="reason"/>
                                    <field name="state" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Return Search View -->
    <record id="view_client_return_search" model="ir.ui.view">
        <field name="name">client.return.search</field>
        <field name="model">client.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="filter_received" string="Received" domain="[('state','=','received')]"/>
                <filter name="filter_refunded" string="Refunded" domain="[('state','=','refunded')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                <filter name="group_by_reason" string="Reason" context="{'group_by':'return_reason'}"/>
                <filter name="group_by_partner" string="Customer" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>

    <!-- Return Action Window -->
    <record id="action_client_return" model="ir.actions.act_window">
        <field name="name">Returns / RMA</field>
        <field name="res_model">client.return</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
