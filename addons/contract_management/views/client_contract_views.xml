<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract List View -->
    <record id="view_client_contract_list" model="ir.ui.view">
        <field name="name">client.contract.list</field>
        <field name="model">client.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="recurring_interval"/>
                <field name="recurring_amount"/>
                <field name="next_invoice_date"/>
            </list>
        </field>
    </record>

    <!-- Contract Form View -->
    <record id="view_client_contract_form" model="ir.ui.view">
        <field name="name">client.contract.form</field>
        <field name="model">client.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'"/>
                    <button name="action_resume" type="object" string="Resume" invisible="state != 'suspended'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <button name="action_generate_invoice" type="object" string="Generate Invoice" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="main_info">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="contract_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="dates_amount">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="recurring_interval"/>
                            <field name="recurring_amount" widget="monetary"/>
                        </group>
                    </group>
                    <group name="recurring">
                        <group>
                            <field name="auto_invoice"/>
                            <field name="next_invoice_date" invisible="not auto_invoice"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Lines" name="lines">
                            <field name="contract_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="tax_id"/>
                                    <field name="service_code"/>
                                    <field name="price_subtotal" widget="monetary" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Linked Invoices" name="invoices">
                            <field name="invoice_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                    <field name="payment_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Contract Search View -->
    <record id="view_client_contract_search" model="ir.ui.view">
        <field name="name">client.contract.search</field>
        <field name="model">client.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_active" string="Active" domain="[('state','=','active')]"/>
                <filter name="filter_suspended" string="Suspended" domain="[('state','=','suspended')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state','=','expired')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <filter name="filter_auto_invoice" string="Auto Invoice" domain="[('auto_invoice','=',True)]"/>
                <filter name="filter_due_invoice" string="Invoice Due" domain="[('next_invoice_date','!=',False),('next_invoice_date','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                <filter name="group_by_type" string="Type" context="{'group_by':'contract_type'}"/>
                <filter name="group_by_partner" string="Customer" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>

    <!-- Contract Action Window -->
    <record id="action_client_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">client.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
