<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Contract sequence: CON-00001 -->
        <record id="seq_client_contract" model="ir.sequence">
            <field name="name">Client Contract</field>
            <field name="code">client.contract</field>
            <field name="prefix">CON-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Return sequence: RMA-00001 -->
        <record id="seq_client_return" model="ir.sequence">
            <field name="name">Client Return</field>
            <field name="code">client.return</field>
            <field name="prefix">RMA-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
