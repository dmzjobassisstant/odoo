<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_hr_issue_user" model="res.groups">
            <field name="name">HR Issue User</field>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_hr_issue_manager" model="res.groups">
            <field name="name">HR Issue Manager</field>
            <field name="implied_ids" eval="[(4, ref('hr_issues.group_hr_issue_user'))]"/>
        </record>

        <!-- Record Rules for hr.issue -->
        <record id="hr_issue_user_rule" model="ir.rule">
            <field name="name">HR Issue: own / assigned / non-confidential</field>
            <field name="model_id" ref="model_hr_issue"/>
            <field name="groups" eval="[(4, ref('hr_issues.group_hr_issue_user'))]"/>
            <field name="domain_force">
                ['|', '|', '|',
                    ('employee_id.user_id', '=', user.id),
                    ('reported_by.user_id', '=', user.id),
                    ('assigned_to.user_id', '=', user.id),
                    ('is_confidential', '=', False)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_issue_manager_rule" model="ir.rule">
            <field name="name">HR Issue: manager full access</field>
            <field name="model_id" ref="model_hr_issue"/>
            <field name="groups" eval="[(4, ref('hr_issues.group_hr_issue_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rules for hr.issue.note -->
        <record id="hr_issue_note_user_rule" model="ir.rule">
            <field name="name">HR Issue Note: own issues</field>
            <field name="model_id" ref="model_hr_issue_note"/>
            <field name="groups" eval="[(4, ref('hr_issues.group_hr_issue_user'))]"/>
            <field name="domain_force">
                ['|',
                    ('issue_id.employee_id.user_id', '=', user.id),
                    ('issue_id.assigned_to.user_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_issue_note_manager_rule" model="ir.rule">
            <field name="name">HR Issue Note: manager full access</field>
            <field name="model_id" ref="model_hr_issue_note"/>
            <field name="groups" eval="[(4, ref('hr_issues.group_hr_issue_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
