<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_issue_note_view_form" model="ir.ui.view">
        <field name="name">hr.issue.note.form</field>
        <field name="model">hr.issue.note</field>
        <field name="arch" type="xml">
            <form string="Internal Note">
                <sheet>
                    <group>
                        <field name="issue_id"/>
                        <field name="author_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="note"/>
                        <field name="is_visible_to_employee"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_issue_note_view_list" model="ir.ui.view">
        <field name="name">hr.issue.note.list</field>
        <field name="model">hr.issue.note</field>
        <field name="arch" type="xml">
            <list string="Internal Notes">
                <field name="issue_id"/>
                <field name="author_id"/>
                <field name="date"/>
                <field name="is_visible_to_employee"/>
            </list>
        </field>
    </record>

</odoo>
