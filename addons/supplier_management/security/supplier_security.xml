<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record model="res.groups.privilege" id="res_groups_privilege_supplier">
        <field name="name">Supplier Management</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_supplier_manager" model="res.groups">
        <field name="name">Supplier Manager</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_manager'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_supplier"/>
    </record>

</data>
<data noupdate="1">

    <record model="ir.rule" id="supplier_contract_comp_rule">
        <field name="name">Supplier Contract multi-company</field>
        <field name="model_id" ref="model_supplier_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="supplier_contract_line_comp_rule">
        <field name="name">Supplier Contract Line multi-company</field>
        <field name="model_id" ref="model_supplier_contract_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</data>
</odoo>
