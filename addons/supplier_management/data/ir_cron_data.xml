<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Sequence for supplier contract references -->
    <record id="seq_supplier_contract" model="ir.sequence">
        <field name="name">Supplier Contract</field>
        <field name="code">supplier.contract</field>
        <field name="prefix">SC</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Cron job: Auto-generate purchase orders from recurring contracts (runs daily) -->
    <record id="ir_cron_generate_supplier_orders" model="ir.cron">
        <field name="name">Supplier Management: Auto-Generate Purchase Orders</field>
        <field name="model_id" ref="model_supplier_contract"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_purchase_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</data>
</odoo>
