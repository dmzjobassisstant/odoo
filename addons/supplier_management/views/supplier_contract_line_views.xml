<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Supplier Contract Line Tree View -->
    <record id="view_supplier_contract_line_tree" model="ir.ui.view">
        <field name="name">supplier.contract.line.tree</field>
        <field name="model">supplier.contract.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="product_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="unit_price" widget="monetary"/>
                <field name="tax_id"/>
                <field name="subtotal" widget="monetary"/>
            </list>
        </field>
    </record>

</odoo>
