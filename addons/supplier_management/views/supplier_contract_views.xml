<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Supplier Contract Tree View -->
    <record id="view_supplier_contract_tree" model="ir.ui.view">
        <field name="name">supplier.contract.tree</field>
        <field name="model">supplier.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="recurring_interval"/>
                <field name="recurring_amount" widget="monetary"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'" decoration-danger="state == 'cancelled'"/>
                <field name="auto_generate_orders"/>
                <field name="next_order_date"/>
            </list>
        </field>
    </record>

    <!-- Supplier Contract Form View -->
    <record id="view_supplier_contract_form" model="ir.ui.view">
        <field name="name">supplier.contract.form</field>
        <field name="model">supplier.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','active')"/>
                    <button name="action_expire" string="Expire" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- placeholder for stat buttons -->
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" required="1"
                                   domain="[('supplier_rank','>', 0)]"/>
                            <field name="contract_type" required="1"/>
                            <field name="start_date" required="1"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="recurring_interval"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="recurring_amount" widget="monetary"/>
                            <field name="payment_method"/>
                            <field name="auto_generate_orders"/>
                            <field name="next_order_date"
                                   invisible="state != 'active' or not auto_generate_orders"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Lines" name="contract_lines">
                            <field name="contract_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="tax_id"/>
                                    <field name="subtotal" widget="monetary" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Supplier Contract Search View -->
    <record id="view_supplier_contract_search" model="ir.ui.view">
        <field name="name">supplier.contract.search</field>
        <field name="model">supplier.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Type" name="filter_contract_type" domain="[]" context="{'group_by': 'contract_type'}"/>
                <filter string="State" name="filter_state" domain="[]" context="{'group_by': 'state'}"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="Active" name="state_active" domain="[('state','=','active')]"/>
                <filter string="Expired" name="state_expired" domain="[('state','=','expired')]"/>
                <filter string="Cancelled" name="state_cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Auto-Generate Orders" name="filter_auto_generate"
                        domain="[('auto_generate_orders','=',True)]"/>
                <filter string="Direct Debit" name="filter_direct_debit"
                        domain="[('payment_method','=','direct_debit')]"/>
            </search>
        </field>
    </record>

</odoo>
