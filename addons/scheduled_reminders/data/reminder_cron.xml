<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job: runs every 5 minutes -->
        <record id="ir_cron_scheduled_reminders" model="ir.cron">
            <field name="name">Scheduled Reminders: Evaluate Rules</field>
            <field name="model_id" ref="model_reminder_rule"/>
            <field name="state">code</field>
            <field name="code">model._evaluate_all()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
